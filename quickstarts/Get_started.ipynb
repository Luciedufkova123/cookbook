    "cc": "compresión cerebral",
    "CRC": "centro de rehabilitación cardiaca",
    "CPR": "kardiopulmonální resuscitace",
    "CR": "capacidad respiratoria",
    "CABG": "coronary artery bypass graft"
  }
};

export default function App() {
  const [input, setInput] = useState("");
  const [translated, setTranslated] = useState("");

  const translateText = () => {
    let result = input;

    Object.values(GLOSSARY).forEach(group => {
      if (Array.isArray(group)) {
        group.forEach(entry => {
          const [lat, cz] = entry.split(" – ");
          if (lat && cz) {
            const regex = new RegExp(`\\b${lat}\\b`, "gi");
            result = result.replace(regex, cz);
          }
        });
      }
    });

    setTranslated(result);
  };

  return (
    <div style={{ display: "flex", height: "100vh", fontFamily: "Arial" }}>
      
      {/* LEVÝ PANEL – PŘEKLADAČ */}
      <div style={{ flex: 2, padding: "20px", background: "#f5f5f5" }}>
        <h2>Překlad lékařských zpráv</h2>

        <textarea
          style={{ width: "100%", height: "200px", padding: "10px" }}
          placeholder="Vlož latinský text..."
          value={input}
          onChange={(e) => setInput(e.target.value)}
        />

        <button
          onClick={translateText}
          style={{
            marginTop: "10px",
            padding: "10px 20px",
            cursor: "pointer",
            background: "#0066ff",
            color: "#fff",
            border: "none",
            borderRadius: "5px"
          }}
        >
          Přeložit
        </button>

        <h3>Přeložený text:</h3>
        <div
          style={{
            background: "#fff",
            padding: "10px",
            border: "1px solid #ccc",
            borderRadius: "5px",
            minHeight: "150px"
          }}
        >
          {translated}
        </div>
      </div>

      {/* PRAVÝ PANEL – SLOVNÍK */}
      <div
        style={{
          flex: 1,
          padding: "20px",
          background: "#ffffff",
          borderLeft: "2px solid #ddd",
          overflowY: "auto"
        }}
      >
        <h2>Slovník</h2>

        {Object.keys(GLOSSARY).map((key) => (
          <div key={key} style={{ marginBottom: "20px" }}>
            <h3>{key}</h3>
            <ul>
              {Array.isArray(GLOSSARY[key])
                ? GLOSSARY[key].map((item, i) => <li key={i}>{item}</li>)
                : Object.entries(GLOSSARY[key]).map(([abbr, expl]) => (
                    <li key={abbr}>
                      <strong>{abbr}</strong>: {expl}
                    </li>
                  ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  );
}
